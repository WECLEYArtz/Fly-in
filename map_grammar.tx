Root:
	Nb_drones

	Start_hub | Hub | End_hub

	Connection*
;
	

Nb_drones:
	'nb_drones:' /[0-9]\d*/
;


Start_hub:
	'start_hub:' Hub_attributes
;


Hub: 
	'hub:' Hub_attributes
;

End_hub:
	'end_hub:' Hub_attributes
;


Hub_attributes:
	name=ID x=INT y=INT
;


	

Connection:
	'Connection:' Connection_attributes
;

Connection_attributes:
	node_start=ID'-'node_end=ID
;

Comment:
  '#'/.*$/
;
