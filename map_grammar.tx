// ------------- ROOT MODULE ---------------
Model:
	/^nb_drones:/ nb_drones=UNSIGNED_NUM 
	hubs*=Hub_types[/\n/]
	connections*=Connection[/\n/]
;

// ------------- HUBS ---------------
Hub_types:
	Start_hub | Norm_hub | End_hub
;

Start_hub:
	/^start_hub:/ Hub_attributes
;

Norm_hub:
	/^hub:/ Hub_attributes
;

End_hub:
	/^end_hub:/ Hub_attributes
;


// ------------- HUBS SUB DATA ---------------
Hub_attributes:
	name=NAME x=INT y=INT ('[' meta*=Hub_meta ']')?
;

Hub_meta:
	key=/color|zone|max_drones/ '=' value=META_VAL
;


// ------------- CONNECTIONS ---------------
Connection:
	/^connection:/ node_start=ID'-'node_end=CONNECTION_NAME ('[' meta*=Con_meta ']')?
;

Con_meta:
	key=/max_link_capacity/ '=' value=META_VAL
;


Comment: '#'/.*$\n/ ;


// ------------- PRESETS ---------------
UNSIGNED_NUM: /[0-9]\d*/;
NAME: /[^\s]*/;
META_VAL: /[^\s\]]*/;
CONNECTION_NAME: /[^\s]*/;
